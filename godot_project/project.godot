[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="EnemyBody"
3d_physics/layer_4="EnemyHitbox"
3d_physics/layer_5="Projectile"
3d_physics/layer_6="Pickup"

[physics]

3d/default_gravity=16.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.0196, 0.0235, 0.0275, 1)
